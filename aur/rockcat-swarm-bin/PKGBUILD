# Maintainer: crt <crt@512mb.net>
# Contributor: TheElevatedOne <adam.mlady@elevated.ovh>
pkgname=rockcat-swarm-bin
_pkgname=rockcat-swarm
pkgver=2.0.0
pkgrel=1
pkgdesc="Open re-implementation of ROCCAT Swarm (GUI, CLI, library) for ROCCAT mice and keyboards"
arch=('x86_64')
url="https://github.com/crt0512/rockcat-swarm"
license=('GPL-3.0-only')
depends=('glibc' 'gcc-libs' 'hidapi' 'gtk3' 'glib2' 'cairo' 'gdk-pixbuf2' 'libayatana-appindicator')
provides=("${_pkgname}")
conflicts=("${_pkgname}" "${_pkgname}-git" 'rossat-swarm-bin' 'rossat-swarm-git')
install="${_pkgname}.install"
source=("${_pkgname}-${pkgver}-x86_64.tar.gz::${url}/releases/download/${pkgver}/${_pkgname}-${pkgver}-x86_64.tar.gz")
# built by .github/workflows/release.yml, run `updpkgsums` once the 2.0.0 release exists
sha256sums=('SKIP')

package() {
    cp -a "${srcdir}/usr" "${pkgdir}/"
    install -Dm644 "${pkgdir}/usr/share/doc/${_pkgname}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
