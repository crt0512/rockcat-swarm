pkgbase = rockcat-swarm-git
	pkgdesc = Open re-implementation of ROCCAT Swarm (GUI, CLI, library) for ROCCAT mice and keyboards (git version)
	pkgver = 2.0.0
	pkgrel = 1
	url = https://github.com/crt0512/rockcat-swarm
	install = rockcat-swarm.install
	arch = x86_64
	license = GPL-3.0-only
	makedepends = git
	makedepends = cmake
	makedepends = ninja
	makedepends = pkgconf
	depends = glibc
	depends = gcc-libs
	depends = hidapi
	depends = gtk3
	depends = glib2
	depends = cairo
	depends = gdk-pixbuf2
	depends = libwebp
	depends = libayatana-appindicator
	provides = rockcat-swarm
	conflicts = rockcat-swarm
	conflicts = rockcat-swarm-bin
	conflicts = rossat-swarm-bin
